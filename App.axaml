<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ActiveRest.App"
             xmlns:local="using:ActiveRest"
             RequestedThemeVariant="Default">
           
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowSurface">#F4F7FC</SolidColorBrush>
                    <SolidColorBrush x:Key="CardSurface">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SoftSurface">#E7EFF7</SolidColorBrush>
                    <SolidColorBrush x:Key="HoverSurface">#D2E0EF</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryText">#102849</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#40546A</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentText">#174C84</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBoundary">#637B96</SolidColorBrush>
                    <SolidColorBrush x:Key="FocusOutline">#174C84</SolidColorBrush>
                    <SolidColorBrush x:Key="FocusCategory">#147542</SolidColorBrush>
                    <SolidColorBrush x:Key="AudioCategory">#145EA8</SolidColorBrush>
                    <SolidColorBrush x:Key="RestCategory">#B0342B</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningText">#8A4824</SolidColorBrush>
                    <SolidColorBrush x:Key="ChartFocus">#102849</SolidColorBrush>
                    <SolidColorBrush x:Key="ChartAudio">#758BA3</SolidColorBrush>
                    <SolidColorBrush x:Key="ChartRest">#EEF4FA</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowSurface">#101C2A</SolidColorBrush>
                    <SolidColorBrush x:Key="CardSurface">#182B40</SolidColorBrush>
                    <SolidColorBrush x:Key="SoftSurface">#223E59</SolidColorBrush>
                    <SolidColorBrush x:Key="HoverSurface">#2B4C6A</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryText">#F2F7FC</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryText">#BED0E2</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentText">#A6D2FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ControlBoundary">#88A5C1</SolidColorBrush>
                    <SolidColorBrush x:Key="FocusOutline">#C4E3FF</SolidColorBrush>
                    <SolidColorBrush x:Key="FocusCategory">#82DBA5</SolidColorBrush>
                    <SolidColorBrush x:Key="AudioCategory">#8BC7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RestCategory">#FFB4A8</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningText">#FFC49C</SolidColorBrush>
                    <SolidColorBrush x:Key="ChartFocus">#F2F7FC</SolidColorBrush>
                    <SolidColorBrush x:Key="ChartAudio">#758BA3</SolidColorBrush>
                    <SolidColorBrush x:Key="ChartRest">#102849</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="CaptionFontSize">12</x:Double>
            <x:Double x:Key="SectionFontSize">17</x:Double>
            <x:Double x:Key="HeadingFontSize">22</x:Double>
            <x:Double x:Key="TitleFontSize">26</x:Double>
            <x:Double x:Key="DatePickerThemeMinWidth">296</x:Double>
            <x:Double x:Key="DatePickerThemeMaxWidth">456</x:Double>
            <x:Double x:Key="DatePickerFlyoutWidth">296</x:Double>
            <x:Double x:Key="DatePickerFlyoutPresenterItemHeight">40</x:Double>
            <x:Double x:Key="DatePickerFlyoutPresenterHighlightHeight">40</x:Double>
            <x:Double x:Key="DatePickerFlyoutPresenterAcceptDismissHostGridHeight">41</x:Double>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button, ToggleButton, CheckBox, ComboBox, DatePicker">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
        </Style>
        <Style Selector="Button, ToggleButton, ComboBox, DatePicker">
            <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBoundary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBoundary}"/>
        </Style>
        <Style Selector="ToggleButton.period:checked">
            <Setter Property="Background" Value="{DynamicResource SoftSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusOutline}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Control">
            <Setter Property="Transitions"><Transitions/></Setter>
            <Setter Property="FocusAdorner">
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusOutline}" BorderThickness="2" CornerRadius="9" Margin="-3" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DatePickerPresenter">
            <Setter Property="Width" Value="{DynamicResource DatePickerFlyoutWidth}"/>
            <Setter Property="MinWidth" Value="{DynamicResource DatePickerFlyoutWidth}"/>
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBoundary}"/>
        </Style>
        <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
            <Setter Property="AutomationProperties.Name" Value="Choose report date"/>
        </Style>
        <Style Selector="DatePickerPresenter /template/ Button#PART_AcceptButton">
            <Setter Property="AutomationProperties.Name" Value="Apply date"/>
        </Style>
        <Style Selector="DatePickerPresenter /template/ Button#PART_DismissButton">
            <Setter Property="AutomationProperties.Name" Value="Cancel date"/>
        </Style>
        <Style Selector="Button:pressed, ToggleButton:pressed">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
    </Application.Styles>

<TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/activerest.ico" ToolTipText="ActiveRest · local activity" Clicked="TrayIcon_Clicked">
     <TrayIcon.Menu>
        <NativeMenu>
          <NativeMenuItem Header="Open the Application" Click="TrayShow_Click" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Safe Exit" Click="TrayExit_Click" />
        </NativeMenu>
      </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

</Application>
