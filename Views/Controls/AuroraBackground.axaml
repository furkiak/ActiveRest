<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ActiveRest.Views.Controls.AuroraBackground"
             IsHitTestVisible="False">
    <!-- Soft colour blobs that the glass cards appear to refract. Static gradients (no blur effects) keep repaints cheap. -->
    <Grid ClipToBounds="True">
        <Ellipse Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-200,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AuroraBlue}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AuroraBlueClear}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-170,-150">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AuroraViolet}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AuroraVioletClear}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-60">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AuroraGreen}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AuroraGreenClear}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
