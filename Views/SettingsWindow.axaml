<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ActiveRest.Views.SettingsWindow"
        Title="Settings" Icon="/Assets/activerest.ico"
        Width="500" Height="760" MinWidth="360" MinHeight="480"
        SystemDecorations="Full" WindowStartupLocation="CenterOwner">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock Text="Application Settings" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
                <TextBlock Text="Local tracking and appearance controls" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                <TextBlock Name="ProfileDescription" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
            </StackPanel>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Appearance" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold"/>
                    <TextBlock Text="Theme" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Name="ThemeChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Appearance theme">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                    <TextBlock Text="Text size" Foreground="{DynamicResource SecondaryText}"/>
                    <ComboBox Name="TextSizeChoice" HorizontalAlignment="Stretch" AutomationProperties.Name="Text size">
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                    <TextBlock Text="Save Changes applies the selected theme and text size to all windows. Text size changes fonts, independently of display scaling."
                               Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                    <TextBlock Text="Opaque surfaces. No background blur or decorative motion."
                               Foreground="{DynamicResource AccentText}" FontSize="{DynamicResource CaptionFontSize}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Break reminder" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <Button Content="−" Click="Minus_Click" AutomationProperties.Name="Decrease reminder interval" Margin="0,0,10,8"/>
                        <TextBlock Name="IntervalValueText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <Button Content="+" Click="Plus_Click" AutomationProperties.Name="Increase reminder interval" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <CheckBox Name="EyeRestCheck">
                        <TextBlock Text="Enable reminder after the chosen focus interval"/>
                    </CheckBox>
                    <CheckBox Name="SundayCheck">
                        <TextBlock Text="Weeks start on Sunday (default: Monday)"/>
                    </CheckBox>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Windows startup" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold"/>
                    <CheckBox Name="AutoStartCheck" AutomationProperties.Name="Start with Windows">
                        <TextBlock Text="Start with Windows"/>
                    </CheckBox>
                    <TextBlock Name="StartupDescription" Text="Optional startup at Windows sign-in; tracking still starts off."
                               Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SoftSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Your data stays on this device" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                    <TextBlock Text="Tracking starts only after you choose Start tracking. Process names, daily durations and settings stay on this device."
                               Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource CaptionFontSize}"/>
                    <WrapPanel>
                        <Button Content="Export JSON" Click="Export_Click" Margin="0,0,8,8"/>
                        <Button Content="Open folder" Click="OpenDataFolder_Click" Margin="0,0,8,8"/>
                        <Button Content="Delete history" Click="Delete_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Name="FeedbackText" Foreground="{DynamicResource WarningText}" FontSize="{DynamicResource CaptionFontSize}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Button Click="Save_Click" HorizontalContentAlignment="Center" FontWeight="Bold" Background="{DynamicResource SoftSurface}">
                <TextBlock Text="Save Changes"/>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Window>
