<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActiveRest.ViewModels"
        xmlns:loc="using:ActiveRest.Localization"
        xmlns:ctl="using:ActiveRest.Views.Controls"
        x:Class="ActiveRest.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="ActiveRest"
        Width="436" Height="800"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/ActiveRest.ico"
        KeyDown="OnKeyDown">

    <Border Classes="windowRoot">
        <Grid>
            <ctl:AuroraBackground/>

            <Grid RowDefinitions="Auto,*,Auto" Margin="22,20,22,20">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnHeaderPointerPressed" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings.title}" Classes="h1"/>
                        <TextBlock Text="{loc:T settings.subtitle}" Classes="cap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Click="Close_Click" VerticalAlignment="Top" ToolTip.Tip="{loc:T tip.close}">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,0,4">

                        <!-- Appearance -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.appearance}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                        <TextBlock Text="{loc:T settings.language}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ListBox Grid.Column="1" Classes="segmented" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                            <ListBoxItem Content="{loc:T lang.auto}"/>
                                            <ListBoxItem Content="{loc:T lang.en}"/>
                                            <ListBoxItem Content="{loc:T lang.tr}"/>
                                        </ListBox>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                                        <TextBlock Text="{loc:T settings.theme}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ListBox Grid.Column="1" Classes="segmented" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                            <ListBoxItem Content="{loc:T theme.system}"/>
                                            <ListBoxItem Content="{loc:T theme.light}"/>
                                            <ListBoxItem Content="{loc:T theme.dark}"/>
                                        </ListBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Eye care -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.eye}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="chip relaxed"><Path Classes="glyph relaxed" Data="{StaticResource IconEye}"/></Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T eye.enable}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T eye.enable.desc}" Classes="micro" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding EyeEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Classes="divider"/>
                                    <StackPanel Spacing="0" IsEnabled="{Binding EyeEnabled}">
                                        <TextBlock Text="{Binding EyeIntervalText}" Classes="cap num"/>
                                        <Slider Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding EyeInterval, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Focus -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.focus}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:T focus.goal}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GoalText}" Classes="cap num"/>
                                        </Grid>
                                        <Slider Minimum="0.5" Maximum="16" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Value="{Binding GoalHours, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Border Classes="divider"/>
                                    <StackPanel Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{loc:T focus.idle}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IdleText}" Classes="cap num"/>
                                        </Grid>
                                        <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding IdleMinutes, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- General -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="{loc:T settings.system}" Classes="cap" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            <Border Classes="glass tile" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStartupSupported}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T startup.enable}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:T startup.desc}" Classes="micro"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Classes="divider" IsVisible="{Binding IsStartupSupported}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{loc:T data.hint}" Classes="micro" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Column="1" Classes="glass" Command="{Binding OpenDataFolderCommand}" Padding="12,8" CornerRadius="14" FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="glyph" Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                                                <TextBlock Text="{loc:T data.open}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                    <TextBlock Text="{Binding VersionText}" Classes="micro" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="1" Classes="accent" Click="Close_Click" Padding="34,11" CornerRadius="16">
                        <TextBlock Text="{loc:T settings.done}"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
