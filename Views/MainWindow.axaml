<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActiveRest.ViewModels"
        x:Class="ActiveRest.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ActiveRest" Icon="/Assets/activerest.ico"
        Width="460" Height="740" MinWidth="360" MinHeight="480"
        SystemDecorations="Full" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="18">
            <WrapPanel>
                <TextBlock Text="ActiveRest" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold" Margin="0,0,18,12" VerticalAlignment="Center"/>
                <Button Click="OpenSettings_Click" ToolTip.Tip="Settings" Margin="0,0,0,12"
                        AutomationProperties.Name="Settings" VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="{DynamicResource CaptionFontSize}"/>
                </Button>
            </WrapPanel>
            <WrapPanel>
                <ToggleButton Classes="period" Content="Day" Command="{Binding ChangeViewModeCommand}" CommandParameter="Daily"
                              IsChecked="{Binding IsDailyView, Mode=OneWay}" Margin="0,0,8,8"/>
                <ToggleButton Classes="period" Content="Week" Command="{Binding ChangeViewModeCommand}" CommandParameter="Weekly"
                              IsChecked="{Binding IsWeeklyView, Mode=OneWay}" Margin="0,0,8,8"/>
                <ToggleButton Classes="period" Content="Month" Command="{Binding ChangeViewModeCommand}" CommandParameter="Monthly"
                              IsChecked="{Binding IsMonthlyView, Mode=OneWay}" Margin="0,0,8,8"/>
                <ToggleButton Classes="period" Content="Year" Command="{Binding ChangeViewModeCommand}" CommandParameter="Yearly"
                              IsChecked="{Binding IsYearlyView, Mode=OneWay}" Margin="0,0,8,8"/>
            </WrapPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding CurrentModeText}" FontSize="{DynamicResource SectionFontSize}" FontWeight="Bold"/>
                <TextBlock Text="{Binding TrackingStatusText}" Foreground="{DynamicResource AccentText}"
                           FontSize="{DynamicResource CaptionFontSize}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Text="{Binding DataStatusText}" Foreground="{DynamicResource WarningText}" FontSize="{DynamicResource CaptionFontSize}"/>
                <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                        Background="{DynamicResource SoftSurface}" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Focused Work" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Text="{Binding FocusedTimeText}" Foreground="{DynamicResource FocusCategory}"
                               FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Audio active while idle" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Text="{Binding RelaxedTimeText}" Foreground="{DynamicResource AudioCategory}"
                               FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Rest" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Text="{Binding BreakTimeText}" Foreground="{DynamicResource RestCategory}"
                               FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <StackPanel Spacing="10">
                <TextBlock Text="Report date" Foreground="{DynamicResource SecondaryText}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <DatePicker SelectedDate="{Binding SelectedDate}" AutomationProperties.Name="Report date"
                                HorizontalAlignment="Left"/>
                </ScrollViewer>
                <Button Click="OpenDetails_Click" HorizontalContentAlignment="Center" FontWeight="SemiBold">
                    <TextBlock Text="Detailed report"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
