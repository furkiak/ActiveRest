<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActiveRest.ViewModels"
        xmlns:loc="using:ActiveRest.Localization"
        xmlns:ctl="using:ActiveRest.Views.Controls"
        x:Class="ActiveRest.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ActiveRest"
        Width="392" Height="744"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Icon="/Assets/ActiveRest.ico"
        Deactivated="OnWindowDeactivated"
        KeyDown="OnKeyDown">

    <Window.Styles>
        <Style Selector="Border#Root">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#Root.hidden">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(16px) scale(0.97)"/>
        </Style>
    </Window.Styles>

    <Border x:Name="Root" Classes="windowRoot hidden">
        <Grid>
            <ctl:AuroraBackground/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,20" Spacing="12">

                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
                        <Image Source="/Assets/ActiveRest.png" Width="42" Height="42"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="ActiveRest" Classes="h1"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="statusDot" VerticalAlignment="Center"
                                         Classes.focus="{Binding IsStatusFocus}"
                                         Classes.relaxed="{Binding IsStatusRelaxed}"
                                         Classes.rest="{Binding IsStatusRest}"/>
                                <TextBlock Text="{Binding StatusText}" Classes="cap"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="icon" Classes.on="{Binding IsPinned}" Command="{Binding TogglePinCommand}"
                                    ToolTip.Tip="{loc:T tip.pin}">
                                <Path Classes="glyph" Data="{StaticResource IconPin}"/>
                            </Button>
                            <Button Classes="icon" Classes.on="{Binding IsPaused}" Command="{Binding TogglePauseCommand}">
                                <Panel>
                                    <Path Classes="glyph" Data="{StaticResource IconPause}" IsVisible="{Binding !IsPaused}"/>
                                    <Path Classes="glyph" Data="{StaticResource IconPlay}" IsVisible="{Binding IsPaused}"/>
                                </Panel>
                            </Button>
                            <Button Classes="icon" Click="OpenSettings_Click" ToolTip.Tip="{loc:T tip.settings}">
                                <Path Classes="glyph" Data="{StaticResource IconGear}" Width="17" Height="17"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Period -->
                    <ListBox Classes="segmented" SelectedIndex="{Binding PeriodIndex, Mode=TwoWay}">
                        <ListBoxItem Content="{loc:T period.day}"/>
                        <ListBoxItem Content="{loc:T period.week}"/>
                        <ListBoxItem Content="{loc:T period.month}"/>
                        <ListBoxItem Content="{loc:T period.year}"/>
                    </ListBox>

                    <!-- Date navigator -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="icon glass" Command="{Binding PreviousCommand}" ToolTip.Tip="{loc:T nav.previous}"
                                Background="{DynamicResource SubtleFillBrush}">
                            <Path Classes="glyph" Data="{StaticResource IconChevronLeft}"/>
                        </Button>

                        <Button x:Name="DateButton" Grid.Column="1" Classes="plain" HorizontalAlignment="Center"
                                ToolTip.Tip="{loc:T nav.pickDate}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RangeTitle}" Classes="h2" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding RangeSubtitle}" Classes="micro" HorizontalAlignment="Center"
                                               IsVisible="{Binding RangeSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <Path Classes="glyph" Data="{StaticResource IconCalendar}" Width="14" Height="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                              DisplayDateEnd="{Binding LastSelectableDate}"
                                              SelectedDatesChanged="OnCalendarSelectionChanged"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Classes="glass" Command="{Binding GoToTodayCommand}" Padding="10,6" CornerRadius="14" FontSize="12"
                                    IsVisible="{Binding !IsCurrentPeriod}" Content="{loc:T nav.backToToday}"/>
                            <Button Classes="icon glass" Command="{Binding NextCommand}" ToolTip.Tip="{loc:T nav.next}"
                                    Background="{DynamicResource SubtleFillBrush}">
                                <Path Classes="glyph" Data="{StaticResource IconChevronRight}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Hero: goal ring + key numbers -->
                    <Border Classes="glass" Padding="16">
                        <Grid ColumnDefinitions="Auto,*">
                            <Grid Width="146" Height="146">
                                <Ellipse Width="146" Height="146" Stroke="{DynamicResource SubtleFillBrush}" StrokeThickness="14"/>
                                <Arc Width="146" Height="146" StartAngle="-90" SweepAngle="{Binding RingSweep}"
                                     Stroke="{DynamicResource FocusRingBrush}" StrokeThickness="14" StrokeLineCap="Round"
                                     IsVisible="{Binding HasProgress}"
                                     Effect="drop-shadow(0 0 10 #4030D158)">
                                    <Arc.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="SweepAngle" Duration="0:0:0.6" Easing="CubicEaseOut"/>
                                        </Transitions>
                                    </Arc.Transitions>
                                </Arc>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                    <Viewbox Width="96" Height="36" StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding HeroTimeText}" Classes="hero num"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding GoalText}" Classes="cap" HorizontalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="chip focus"><Path Classes="glyph focus" Data="{StaticResource IconTimer}"/></Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LongestFocusText}" Classes="h2 num" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{loc:T insight.longest}" Classes="micro" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="chip relaxed"><Path Classes="glyph relaxed" Data="{StaticResource IconClock}"/></Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TrackedText}" Classes="h2 num" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{loc:T details.total}" Classes="micro" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="chip rest"><Path Classes="glyph rest" Data="{StaticResource IconFire}"/></Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StreakText}" Classes="h2 num" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{loc:T stat.streak}" Classes="micro" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Mode tiles -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Classes="glass tile" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="chip focus" Width="28" Height="28"><Path Classes="glyph focus" Data="{StaticResource IconTarget}" Width="15" Height="15"/></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding FocusPercentText}" Classes="cap num" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding FocusTimeText}" Classes="h2 num focusText"/>
                                    <TextBlock Text="{loc:T mode.focus}" Classes="cap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="glass tile" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="chip relaxed" Width="28" Height="28"><Path Classes="glyph relaxed" Data="{StaticResource IconHeadphones}" Width="15" Height="15"/></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding RelaxedPercentText}" Classes="cap num" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding RelaxedTimeText}" Classes="h2 num relaxedText"/>
                                    <TextBlock Text="{loc:T mode.relaxed}" Classes="cap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="glass tile" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="chip rest" Width="28" Height="28"><Path Classes="glyph rest" Data="{StaticResource IconCoffee}" Width="15" Height="15"/></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding RestPercentText}" Classes="cap num" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding RestTimeText}" Classes="h2 num restText"/>
                                    <TextBlock Text="{loc:T mode.rest}" Classes="cap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Trend chart -->
                    <Border Classes="glass" Padding="16,14,16,8">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding ChartTitle}" Classes="h2"/>
                                <TextBlock Grid.Column="1" Text="{Binding ChartCaption}" Classes="micro num" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Height="102">
                                <ItemsControl ItemsSource="{Binding ChartBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChartBarViewModel">
                                            <Grid RowDefinitions="*,18" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                                                <Border Classes="bar" Height="{Binding Height}" Margin="1.5,0" MaxWidth="22"
                                                        Classes.current="{Binding IsCurrent}"
                                                        Classes.met="{Binding MetGoal}"
                                                        Classes.empty="{Binding IsEmpty}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" Classes="micro num" FontSize="9.5"
                                                           Width="44" TextAlignment="Center" HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom" IsVisible="{Binding ShowLabel}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:T chart.empty}" Classes="cap" HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,28,0,0" IsVisible="{Binding !HasChartData}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Classes="accent" Click="OpenDetails_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Path Classes="glyph" Data="{StaticResource IconChart}" Fill="White"/>
                            <TextBlock Text="{loc:T btn.report}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
