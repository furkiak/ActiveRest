<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActiveRest.ViewModels"
        xmlns:models="using:ActiveRest.Models"
        xmlns:loc="using:ActiveRest.Localization"
        xmlns:ctl="using:ActiveRest.Views.Controls"
        x:Class="ActiveRest.Views.DetailsWindow"
        x:DataType="vm:DetailsViewModel"
        Title="ActiveRest"
        Width="456" Height="760"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/ActiveRest.ico"
        KeyDown="OnKeyDown">

    <Border Classes="windowRoot">
        <Grid>
            <ctl:AuroraBackground/>

            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22,20,22,20">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
                    <StackPanel>
                        <TextBlock Text="{loc:T details.title}" Classes="h1"/>
                        <TextBlock Text="{Binding Main.ReportTitle}" Classes="cap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Click="Close_Click" VerticalAlignment="Top" ToolTip.Tip="{loc:T tip.close}">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <!-- Distribution -->
                <Border Grid.Row="1" Classes="glass" Padding="18" Margin="0,16,0,12">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:T details.total}" Classes="cap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Main.TrackedText}" Classes="h1 num"/>
                        </Grid>

                        <Border Height="12" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Main.FocusColumn}"/>
                                    <ColumnDefinition Width="{Binding Main.RelaxedColumn}"/>
                                    <ColumnDefinition Width="{Binding Main.RestColumn}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource FocusBrush}"/>
                                <Border Grid.Column="1" Background="{DynamicResource RelaxedBrush}"/>
                                <Border Grid.Column="2" Background="{DynamicResource RestBrush}"/>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="Auto,*,Auto,52">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource FocusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{loc:T mode.focus}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Main.FocusTimeText}" Classes="cap num"/>
                                <TextBlock Grid.Column="3" Text="{Binding Main.FocusPercentText}" Classes="cap num" TextAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,52">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource RelaxedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{loc:T mode.relaxed}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Main.RelaxedTimeText}" Classes="cap num"/>
                                <TextBlock Grid.Column="3" Text="{Binding Main.RelaxedPercentText}" Classes="cap num" TextAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto,52">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource RestBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{loc:T mode.rest}" Margin="10,0,0,0" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Main.RestTimeText}" Classes="cap num"/>
                                <TextBlock Grid.Column="3" Text="{Binding Main.RestPercentText}" Classes="cap num" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Highlights -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="0,0,0,12">
                    <Border Classes="glass tile" Padding="14,12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph focus" Data="{StaticResource IconChart}" Width="13" Height="13"/>
                                <TextBlock Text="{loc:T insight.peak}" Classes="cap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Main.PeakHourText}" Classes="h2 num"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="glass tile" Padding="14,12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph relaxed" Data="{StaticResource IconTimer}" Width="13" Height="13"/>
                                <TextBlock Text="{loc:T insight.longest}" Classes="cap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Main.LongestFocusText}" Classes="h2 num"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="glass tile" Padding="14,12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph rest" Data="{StaticResource IconApps}" Width="13" Height="13"/>
                                <TextBlock Text="{loc:T insight.top}" Classes="cap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Main.TopAppText}" Classes="h2" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Classes="glass tile" Padding="14,12">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph" Data="{StaticResource IconClock}" Width="13" Height="13"/>
                                <TextBlock Text="{Binding Main.FourthInsightLabel}" Classes="cap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Main.FourthInsightText}" Classes="h2 num"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Applications -->
                <Border Grid.Row="3" Classes="glass" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="{loc:T details.apps}" Classes="h2" Margin="18,14,18,4"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <ItemsControl ItemsSource="{Binding Main.AppUsageList}" Margin="18,0,18,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AppUsageItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,7">
                                                <Border Width="34" Height="34" CornerRadius="11"
                                                        Background="{Binding Hue, Converter={StaticResource HueSoft}}">
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{Binding Hue, Converter={StaticResource HueStrong}}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,10,0" Spacing="6" VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DurationText}" Classes="cap num" Margin="8,0,0,0"/>
                                                    </Grid>
                                                    <ProgressBar Classes="capsule" Value="{Binding Fraction}"
                                                                 Foreground="{Binding Hue, Converter={StaticResource HueStrong}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentageText}" Classes="cap num" Width="42"
                                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:T details.apps.empty}" Classes="cap" HorizontalAlignment="Center" Margin="0,30,0,0"
                                           IsVisible="{Binding !Main.HasApps}"/>
                            </Panel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Export -->
                <StackPanel Grid.Row="4" Spacing="10" Margin="0,14,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Classes="accent" Click="ExportPdf_Click" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Path Classes="glyph" Data="{StaticResource IconFile}" Fill="White"/>
                                <TextBlock Text="{loc:T export.pdf}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="glass" Click="ExportCsv_Click" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" CornerRadius="18" Padding="18,13">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Path Classes="glyph" Data="{StaticResource IconTable}"/>
                                <TextBlock Text="{loc:T export.csv}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStatus}">
                        <TextBlock Text="{Binding StatusText}" Classes="cap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="plain" Command="{Binding RevealCommand}" IsVisible="{Binding CanReveal}"
                                Padding="10,4" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph relaxed" Data="{StaticResource IconFolder}" Width="13" Height="13"/>
                                <TextBlock Text="{loc:T export.show}" Foreground="{DynamicResource RelaxedTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
