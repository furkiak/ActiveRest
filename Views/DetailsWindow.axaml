<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActiveRest.ViewModels"
        xmlns:models="using:ActiveRest.Models"
        x:Class="ActiveRest.Views.DetailsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Detailed Analysis" Icon="/Assets/activerest.ico"
        Width="520" Height="740" MinWidth="360" MinHeight="480"
        SystemDecorations="Full" WindowStartupLocation="CenterOwner">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Detailed Analysis" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
                <TextBlock Text="Device usage summary and detailed application report" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource SecondaryText}"/>
                <TextBlock Text="{Binding CurrentModeText}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold"/>
            </StackPanel>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Total Session Duration" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock Text="{Binding TotalUptimeText}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"/>
                    <Border CornerRadius="6" Height="14" ClipToBounds="True" IsVisible="{Binding HasSessionTime}"
                            BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ChartFocusWidth}"/>
                                <ColumnDefinition Width="{Binding ChartRelaxWidth}"/>
                                <ColumnDefinition Width="{Binding ChartBreakWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ChartFocus}"/>
                            <Border Grid.Column="1" Background="{DynamicResource ChartAudio}"/>
                            <Border Grid.Column="2" Background="{DynamicResource ChartRest}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="No measured time in this period yet." IsVisible="{Binding NoSessionTime}" Foreground="{DynamicResource SecondaryText}"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Focused Work" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FocusStatText}" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Audio active while idle" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RelaxStatText}" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rest" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BreakStatText}" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlBoundary}" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding AppUsageList}" IsVisible="{Binding HasAppUsage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AppUsageItem">
                                <StackPanel Spacing="5" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold"/>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource SecondaryText}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding PercentageText}" Foreground="{DynamicResource AccentText}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="6" IsVisible="{Binding NoAppUsage}">
                        <TextBlock Text="No app activity recorded yet" FontWeight="SemiBold"/>
                        <TextBlock Text="Start tracking to see local process totals." Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Click="ExportToPdf_Click" HorizontalContentAlignment="Center" FontWeight="Bold">
                <TextBlock Text="Export PDF summary"/>
            </Button>
            <TextBlock Name="ExportFeedbackText" Foreground="{DynamicResource AccentText}" FontSize="{DynamicResource CaptionFontSize}"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</Window>
