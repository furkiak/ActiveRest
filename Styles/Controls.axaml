<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Windows ===== -->
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Border.windowRoot">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="32"/>
        <Setter Property="BoxShadow" Value="{DynamicResource WindowShadow}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="16"/>
    </Style>

    <!-- ===== Glass surfaces ===== -->
    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    </Style>
    <Style Selector="Border.glass.tile">
        <Setter Property="CornerRadius" Value="20"/>
    </Style>
    <Style Selector="Border.glass.flat">
        <Setter Property="BoxShadow" Value="none"/>
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    </Style>

    <!-- ===== Typography ===== -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.hero">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.5"/>
    </Style>
    <Style Selector="TextBlock.cap">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.micro">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.num">
        <Setter Property="FontFeatures" Value="+tnum"/>
    </Style>
    <Style Selector="TextBlock.focusText"><Setter Property="Foreground" Value="{DynamicResource FocusTextBrush}"/></Style>
    <Style Selector="TextBlock.relaxedText"><Setter Property="Foreground" Value="{DynamicResource RelaxedTextBrush}"/></Style>
    <Style Selector="TextBlock.restText"><Setter Property="Foreground" Value="{DynamicResource RestTextBrush}"/></Style>

    <!-- ===== Icon chips ===== -->
    <Style Selector="Border.chip">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
    </Style>
    <Style Selector="Border.chip.focus"><Setter Property="Background" Value="{DynamicResource FocusSoftBrush}"/></Style>
    <Style Selector="Border.chip.relaxed"><Setter Property="Background" Value="{DynamicResource RelaxedSoftBrush}"/></Style>
    <Style Selector="Border.chip.rest"><Setter Property="Background" Value="{DynamicResource RestSoftBrush}"/></Style>

    <Style Selector="Path.glyph">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Path.glyph.focus"><Setter Property="Fill" Value="{DynamicResource FocusTextBrush}"/></Style>
    <Style Selector="Path.glyph.relaxed"><Setter Property="Fill" Value="{DynamicResource RelaxedTextBrush}"/></Style>
    <Style Selector="Path.glyph.rest"><Setter Property="Fill" Value="{DynamicResource RestTextBrush}"/></Style>

    <!-- ===== Buttons ===== -->
    <Style Selector="Button.glass, Button.accent, Button.icon, Button.plain">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.glass /template/ ContentPresenter#PART_ContentPresenter, Button.accent /template/ ContentPresenter#PART_ContentPresenter, Button.icon /template/ ContentPresenter#PART_ContentPresenter, Button.plain /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.glass">
        <Setter Property="Background" Value="{DynamicResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16,11"/>
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.glass:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassPressedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.glass:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18,13"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentGradientHoverBrush}"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
    </Style>
    <Style Selector="Button.accent:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassPressedBrush}"/>
    </Style>
    <Style Selector="Button.icon:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
    <Style Selector="Button.icon:pointerover Path.glyph"><Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/></Style>
    <Style Selector="Button.icon.on Path.glyph"><Setter Property="Fill" Value="{DynamicResource RelaxedTextBrush}"/></Style>
    <Style Selector="Button.icon.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RelaxedSoftBrush}"/>
    </Style>

    <Style Selector="Button.plain">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.plain:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource GlassPressedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== Segmented control (ListBox) ===== -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SegmentThumbBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #26000000"/>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SegmentThumbBrush}"/>
    </Style>
    <Style Selector="ListBox.segmented > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SegmentThumbBrush}"/>
    </Style>

    <!-- ===== Live status dot ===== -->
    <Style Selector="Ellipse.statusDot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource PausedBrush}"/>
    </Style>
    <Style Selector="Ellipse.statusDot.focus"><Setter Property="Fill" Value="{DynamicResource FocusBrush}"/></Style>
    <Style Selector="Ellipse.statusDot.relaxed"><Setter Property="Fill" Value="{DynamicResource RelaxedBrush}"/></Style>
    <Style Selector="Ellipse.statusDot.rest"><Setter Property="Fill" Value="{DynamicResource RestBrush}"/></Style>

    <!-- ===== Chart bars ===== -->
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{DynamicResource FocusBrush}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Height" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.bar.met"><Setter Property="Opacity" Value="0.85"/></Style>
    <Style Selector="Border.bar.current">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource FocusRingBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource GlowFocusShadow}"/>
    </Style>
    <Style Selector="Border.bar.empty">
        <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- ===== App usage capsule bar ===== -->
    <Style Selector="ProgressBar.capsule">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}"/>
    </Style>
    <Style Selector="ProgressBar.capsule /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <!-- ===== Switch & slider rows ===== -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>
    <Style Selector="Slider">
        <Setter Property="MinWidth" Value="120"/>
    </Style>
</Styles>
